{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifquant.org/contracts/tissue/v1/marker-thresholds.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ifquant.marker-thresholds/1"
    },
    "thresholds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "measurement_id": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "minimum_inclusive": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "measurement_id",
          "unit",
          "minimum_inclusive"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "thresholds"
  ],
  "additionalProperties": false
}
