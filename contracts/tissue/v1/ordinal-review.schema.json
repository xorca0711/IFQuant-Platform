{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifquant.org/contracts/tissue/v1/ordinal-review.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ifquant.ordinal-review/1"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rubric": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "ifquant.ordinal-rubric/1"
        },
        "rubric_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "endpoint_id": {
                "type": "string",
                "minLength": 1
              },
              "anatomies": {
                "type": "array",
                "items": {
                  "enum": [
                    "alveolar_parenchyma",
                    "airway",
                    "vessel",
                    "pleura",
                    "unresolved"
                  ]
                },
                "minItems": 1
              },
              "levels": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "score": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "definition": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "score",
                    "label",
                    "definition"
                  ],
                  "additionalProperties": false
                },
                "minItems": 2
              }
            },
            "required": [
              "endpoint_id",
              "anatomies",
              "levels"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "rubric_id",
        "description",
        "reference",
        "endpoints"
      ],
      "additionalProperties": false
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region_id": {
            "type": "string",
            "minLength": 1
          },
          "endpoint_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "accepted",
              "uncertain",
              "not_applicable"
            ]
          },
          "score": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "reviewer": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "at": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "region_id",
          "endpoint_id",
          "status",
          "score",
          "reviewer",
          "at",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "package_sha256",
    "rubric",
    "rows"
  ],
  "additionalProperties": false
}
