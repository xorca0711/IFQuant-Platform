{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifquant.org/contracts/tissue/v1/ordinal-rubric.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "ifquant.ordinal-rubric/1"
    },
    "rubric_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "endpoint_id": {
            "type": "string",
            "minLength": 1
          },
          "anatomies": {
            "type": "array",
            "items": {
              "enum": [
                "alveolar_parenchyma",
                "airway",
                "vessel",
                "pleura",
                "unresolved"
              ]
            },
            "minItems": 1
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "score": {
                  "type": "integer",
                  "minimum": 0
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "definition": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "score",
                "label",
                "definition"
              ],
              "additionalProperties": false
            },
            "minItems": 2
          }
        },
        "required": [
          "endpoint_id",
          "anatomies",
          "levels"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "rubric_id",
    "description",
    "reference",
    "endpoints"
  ],
  "additionalProperties": false
}
