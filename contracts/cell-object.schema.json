{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifquant.org/contracts/platform/v1/cell-object.schema.json",
  "title": "IFQuant Platform cell object",
  "description": "One deterministic, backend-neutral cell object for canonical JSON Lines export.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract_type",
    "contract_version",
    "object_id",
    "object_index",
    "package_id",
    "image_id",
    "biological_unit_id",
    "annotation_id",
    "segmentation_run_id",
    "coordinate_space_id",
    "geometry",
    "centroids",
    "morphology_measurements",
    "intensity_measurements",
    "qc",
    "review",
    "provenance"
  ],
  "properties": {
    "$schema": {
      "const": "https://ifquant.org/contracts/platform/v1/cell-object.schema.json"
    },
    "contract_type": {
      "const": "ifquant_platform_cell_object"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "object_id": {
      "$ref": "#/$defs/sha256"
    },
    "object_index": {
      "$ref": "#/$defs/nonnegative_integer"
    },
    "package_id": {
      "$ref": "#/$defs/identifier"
    },
    "image_id": {
      "$ref": "#/$defs/identifier"
    },
    "biological_unit_id": {
      "$ref": "#/$defs/identifier"
    },
    "annotation_id": {
      "$ref": "#/$defs/identifier"
    },
    "segmentation_run_id": {
      "$ref": "#/$defs/identifier"
    },
    "coordinate_space_id": {
      "$ref": "#/$defs/identifier"
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell",
        "nucleus"
      ],
      "properties": {
        "cell": {
          "$ref": "#/$defs/wkt_geometry"
        },
        "nucleus": {
          "$ref": "#/$defs/wkt_geometry"
        }
      }
    },
    "centroids": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_x",
        "cell_y",
        "nucleus_x",
        "nucleus_y",
        "unit"
      ],
      "properties": {
        "cell_x": {
          "type": "number"
        },
        "cell_y": {
          "type": "number"
        },
        "nucleus_x": {
          "type": "number"
        },
        "nucleus_y": {
          "type": "number"
        },
        "unit": {
          "const": "pixel"
        }
      }
    },
    "morphology_measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/morphology_measurement"
      }
    },
    "intensity_measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/intensity_measurement"
      }
    },
    "predictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prediction"
      }
    },
    "qc": {
      "$ref": "#/$defs/qc"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "source_detection_id",
        "exporter_id",
        "exporter_version",
        "exporter_code_sha256"
      ],
      "properties": {
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "source_detection_id": {
          "type": "string",
          "minLength": 1
        },
        "exporter_id": {
          "$ref": "#/$defs/identifier"
        },
        "exporter_version": {
          "$ref": "#/$defs/semver"
        },
        "exporter_code_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "wkt_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "geometry_type",
        "wkt"
      ],
      "properties": {
        "encoding": {
          "const": "WKT1"
        },
        "geometry_type": {
          "enum": [
            "POLYGON",
            "MULTIPOLYGON"
          ]
        },
        "wkt": {
          "type": "string",
          "pattern": "^(POLYGON|MULTIPOLYGON)\\s*\\("
        }
      }
    },
    "morphology_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_id",
        "compartment",
        "feature",
        "value",
        "unit"
      ],
      "properties": {
        "measurement_id": {
          "$ref": "#/$defs/identifier"
        },
        "compartment": {
          "enum": [
            "cell",
            "nucleus",
            "cytoplasm"
          ]
        },
        "feature": {
          "enum": [
            "area",
            "perimeter",
            "circularity",
            "solidity",
            "eccentricity",
            "major_axis_length",
            "minor_axis_length",
            "nucleus_cell_area_ratio"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "um2",
            "um",
            "ratio"
          ]
        }
      }
    },
    "intensity_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement_id",
        "channel_id",
        "marker_id",
        "compartment",
        "statistic",
        "value",
        "unit"
      ],
      "properties": {
        "measurement_id": {
          "$ref": "#/$defs/identifier"
        },
        "channel_id": {
          "$ref": "#/$defs/identifier"
        },
        "marker_id": {
          "$ref": "#/$defs/identifier"
        },
        "compartment": {
          "enum": [
            "cell",
            "nucleus",
            "cytoplasm"
          ]
        },
        "statistic": {
          "enum": [
            "mean",
            "median",
            "minimum",
            "maximum",
            "standard_deviation",
            "sum"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "native_sample_value",
            "normalized_intensity",
            "integrated_native_sample_value"
          ]
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prediction_id",
        "task_id",
        "model_id",
        "model_sha256",
        "label",
        "score",
        "calibrated_probability",
        "abstained",
        "abstention_reason"
      ],
      "properties": {
        "prediction_id": {
          "$ref": "#/$defs/identifier"
        },
        "task_id": {
          "$ref": "#/$defs/identifier"
        },
        "model_id": {
          "$ref": "#/$defs/identifier"
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "label": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "calibrated_probability": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "abstained": {
          "type": "boolean"
        },
        "abstention_reason": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "flags"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "not_evaluated"
          ]
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "severity",
              "message"
            ],
            "properties": {
              "code": {
                "$ref": "#/$defs/identifier"
              },
              "severity": {
                "enum": [
                  "info",
                  "warning",
                  "error"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "revision",
        "reviewer_id",
        "reviewed_at",
        "notes",
        "supersedes_object_id"
      ],
      "properties": {
        "state": {
          "enum": [
            "unreviewed",
            "accepted",
            "corrected",
            "rejected"
          ]
        },
        "revision": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "reviewer_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewed_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "supersedes_object_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
