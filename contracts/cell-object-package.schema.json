{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifquant.org/contracts/platform/v1/cell-object-package.schema.json",
  "title": "IFQuant Platform cell-object package",
  "description": "Content-addressed package binding image and biological identity, channels, annotations, calibration, segmentation, one JSONL cell-object artifact, QC, review, and provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract_type",
    "contract_version",
    "package_id",
    "image",
    "biological_unit",
    "channel_map",
    "annotation_set",
    "pixel_calibration",
    "coordinate_space",
    "segmentation_run",
    "measurement_method",
    "cell_objects_artifact",
    "qc",
    "review",
    "provenance"
  ],
  "properties": {
    "$schema": {
      "const": "https://ifquant.org/contracts/platform/v1/cell-object-package.schema.json"
    },
    "contract_type": {
      "const": "ifquant_platform_cell_object_package"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "package_id": {
      "$ref": "#/$defs/identifier"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_id",
        "manifest_relative_path",
        "manifest_sha256",
        "source_sha256"
      ],
      "properties": {
        "image_id": {
          "$ref": "#/$defs/identifier"
        },
        "manifest_relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "biological_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "biological_unit_id",
        "mouse_id",
        "specimen_id",
        "section_id",
        "slide_id",
        "batch_id",
        "scanner_id"
      ],
      "properties": {
        "biological_unit_id": {
          "$ref": "#/$defs/identifier"
        },
        "mouse_id": {
          "$ref": "#/$defs/nullable_identifier"
        },
        "specimen_id": {
          "$ref": "#/$defs/nullable_identifier"
        },
        "section_id": {
          "$ref": "#/$defs/nullable_identifier"
        },
        "slide_id": {
          "$ref": "#/$defs/nullable_identifier"
        },
        "batch_id": {
          "$ref": "#/$defs/nullable_identifier"
        },
        "scanner_id": {
          "$ref": "#/$defs/nullable_identifier"
        }
      }
    },
    "channel_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_map_id",
        "manifest_relative_path",
        "manifest_sha256"
      ],
      "properties": {
        "channel_map_id": {
          "$ref": "#/$defs/identifier"
        },
        "manifest_relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "annotation_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotation_set_id",
        "manifest_relative_path",
        "manifest_sha256"
      ],
      "properties": {
        "annotation_set_id": {
          "$ref": "#/$defs/identifier"
        },
        "manifest_relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "pixel_calibration": {
      "$ref": "#/$defs/pixel_calibration"
    },
    "coordinate_space": {
      "$ref": "#/$defs/coordinate_space"
    },
    "segmentation_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segmentation_run_id",
        "manifest_relative_path",
        "manifest_sha256",
        "backend_kind",
        "backend_sha256",
        "model_sha256",
        "weights_sha256",
        "detector_config_sha256",
        "preprocessing_sha256"
      ],
      "properties": {
        "segmentation_run_id": {
          "$ref": "#/$defs/identifier"
        },
        "manifest_relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "backend_kind": {
          "enum": [
            "native_qupath",
            "stardist",
            "instanseg"
          ]
        },
        "backend_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "weights_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "detector_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "preprocessing_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "measurement_method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_id",
        "definition_relative_path",
        "definition_sha256",
        "parameter_set_id",
        "parameter_set_relative_path",
        "parameter_set_sha256",
        "method_instance_sha256"
      ],
      "properties": {
        "definition_id": {
          "$ref": "#/$defs/identifier"
        },
        "definition_relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "parameter_set_id": {
          "$ref": "#/$defs/identifier"
        },
        "parameter_set_relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "parameter_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "method_instance_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "cell_objects_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "media_type",
        "schema_id",
        "sha256",
        "size_bytes",
        "record_count",
        "ordering"
      ],
      "properties": {
        "relative_path": {
          "$ref": "#/$defs/relative_path"
        },
        "media_type": {
          "const": "application/x-ndjson"
        },
        "schema_id": {
          "const": "https://ifquant.org/contracts/platform/v1/cell-object.schema.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "record_count": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "ordering": {
          "const": "object_index_ascending"
        }
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "object_count",
        "pass_count",
        "warning_count",
        "fail_count",
        "not_evaluated_count",
        "flags"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "not_evaluated"
          ]
        },
        "object_count": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "pass_count": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "warning_count": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "fail_count": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "not_evaluated_count": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/qc_flag"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reviewed_object_count",
        "reviewer_ids",
        "last_reviewed_at"
      ],
      "properties": {
        "state": {
          "enum": [
            "unreviewed",
            "in_review",
            "reviewed",
            "requires_revision"
          ]
        },
        "reviewed_object_count": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "reviewer_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "last_reviewed_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "producer_id",
        "producer_version",
        "code_revision",
        "package_config_sha256",
        "parent_package_id"
      ],
      "properties": {
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "producer_id": {
          "$ref": "#/$defs/identifier"
        },
        "producer_version": {
          "$ref": "#/$defs/semver"
        },
        "code_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "package_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "parent_package_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "segmentation_run": {
            "properties": {
              "backend_kind": {
                "const": "native_qupath"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "segmentation_run": {
            "properties": {
              "weights_sha256": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "segmentation_run": {
            "properties": {
              "backend_kind": {
                "enum": [
                  "stardist",
                  "instanseg"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "segmentation_run": {
            "properties": {
              "weights_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "nullable_identifier": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positive_number": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "pixel_calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_id",
        "pixel_width_um",
        "pixel_height_um",
        "z_spacing_um",
        "unit"
      ],
      "properties": {
        "calibration_id": {
          "$ref": "#/$defs/identifier"
        },
        "pixel_width_um": {
          "$ref": "#/$defs/positive_number"
        },
        "pixel_height_um": {
          "$ref": "#/$defs/positive_number"
        },
        "z_spacing_um": {
          "oneOf": [
            {
              "$ref": "#/$defs/positive_number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "const": "um"
        }
      }
    },
    "coordinate_space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_space_id",
        "dimension",
        "geometry_unit",
        "axis_order",
        "origin",
        "x_axis_direction",
        "y_axis_direction"
      ],
      "properties": {
        "coordinate_space_id": {
          "$ref": "#/$defs/identifier"
        },
        "dimension": {
          "const": "2d"
        },
        "geometry_unit": {
          "const": "pixel"
        },
        "axis_order": {
          "type": "array",
          "prefixItems": [
            {
              "const": "x"
            },
            {
              "const": "y"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "origin": {
          "const": "top_left"
        },
        "x_axis_direction": {
          "const": "right"
        },
        "y_axis_direction": {
          "const": "down"
        }
      }
    },
    "qc_flag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/identifier"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
