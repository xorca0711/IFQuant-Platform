{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ifquant.org/contracts/platform/v1/segmentation-evaluation-plan.schema.json",
  "title": "IFQuant Platform segmentation evaluation plan",
  "description": "Prospectively frozen Phase 4 evaluation choices. Runtime validation additionally resolves and verifies every bound Phase 3 artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "contract_type", "contract_version", "evaluation_plan_id", "state", "declared_at", "backend_id", "split_manifest", "reference_set_sha256", "reference_instances", "partitions", "thresholds", "acceptance_criteria", "claims"],
  "properties": {
    "$schema": {"const": "https://ifquant.org/contracts/platform/v1/segmentation-evaluation-plan.schema.json"},
    "contract_type": {"const": "ifquant_platform_segmentation_evaluation_plan"},
    "contract_version": {"const": "1.0.0"},
    "evaluation_plan_id": {"type": "string", "minLength": 1},
    "state": {"const": "frozen"},
    "declared_at": {"type": "string", "format": "date-time"},
    "backend_id": {"const": "native_qupath"},
    "split_manifest": {"$ref": "#/$defs/artifact"},
    "reference_set_sha256": {"$ref": "#/$defs/sha256"},
    "reference_instances": {"$ref": "#/$defs/artifact"},
    "partitions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["train", "tuning", "held_out_test"]}},
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["match_iou", "split_merge_overlap_fraction", "boundary_tolerance_pixels", "size_strata_pixels"],
      "properties": {
        "match_iou": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "split_merge_overlap_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "boundary_tolerance_pixels": {"type": "integer", "minimum": 0},
        "size_strata_pixels": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 2}], "items": false}
      }
    },
    "acceptance_criteria": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "minimum_evaluable_image_count", "minimum_reference_object_count", "minimum_precision", "minimum_recall", "minimum_f1", "minimum_boundary_f1", "maximum_split_rate", "maximum_merge_rate", "maximum_mean_absolute_count_error_per_image", "maximum_measurement_mae"],
      "properties": {
        "scope": {"type": "string", "minLength": 1},
        "minimum_evaluable_image_count": {"type": "integer", "minimum": 1},
        "minimum_reference_object_count": {"type": "integer", "minimum": 1},
        "minimum_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_f1": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_boundary_f1": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_split_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_merge_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_mean_absolute_count_error_per_image": {"type": "number", "minimum": 0},
        "maximum_measurement_mae": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["measurement_id", "maximum_mae"],
            "properties": {"measurement_id": {"type": "string", "minLength": 1}, "maximum_mae": {"type": "number", "minimum": 0}}
          }
        }
      }
    },
    "claims": {"type": "object", "additionalProperties": false, "required": ["scientific_validation", "backend_equivalence", "model_universality", "authorization"], "properties": {"scientific_validation": {"const": false}, "backend_equivalence": {"const": false}, "model_universality": {"const": false}, "authorization": {"const": "none"}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256"], "properties": {"relative_path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
